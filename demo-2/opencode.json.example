{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "filesystem": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@1.0.0", "{{DEMO2_DIR}}"]
      },
      "sqlite": {
        "type": "local",
        "command": ["mcp-server-sqlite", "--db-path", "{{DEMO2_DIR}}/demo.sqlite"]
      },
      "fetch": {
        "type": "local",
        "command": ["mcp-server-fetch"]
      }
    }
  }
}
